{
  "name": "nimba-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Monts Nimba interactive 3D demo \u2013 unofficial Phase 0 prototype (Tech Guin\u00e9e for CSIG, fiche P19)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "screens": "node scripts/screens.mjs",
    "check:panel": "node scripts/check-panel.mjs",
    "check:walk": "node scripts/check-walk.mjs",
    "check:walk-flow": "node scripts/check-walk-flow.mjs",
    "data:osm": ".venv/bin/python scripts/worldpack/fetch_osm.py",
    "data:walk": ".venv/bin/python scripts/worldpack/build_walk_data.py",
    "assets:textures": "NODE_USE_ENV_PROXY=1 node scripts/fetch_textures.mjs",
    "assets:models": "NODE_USE_ENV_PROXY=1 node scripts/fetch_models.mjs",
    "check:tour": "node scripts/check-tour.mjs",
    "check:walk-controls": "node scripts/check-walk-controls.mjs",
    "check:walk-physics": "node scripts/check-walk-physics.mjs",
    "check:walk-quality": "node scripts/check-walk-quality.mjs",
    "check:world-art": "node scripts/check-world-art.mjs",
    "check:art-ui": "node scripts/check-art-ui.mjs",
    "assets:world-art": "node scripts/build_world_art.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.187.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.34.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "22.x"
  }
}
